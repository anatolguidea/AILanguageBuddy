# Option 1: Set environment variables (recommended for CI/local)
#   export GROQ_API_KEY=your_groq_api_key_here
#   export DATASOURCE_URL="jdbc:postgresql://HOST:6543/postgres?user=...&password=..."

# Option 2: Copy this to application-local.properties and fill in real values.
#   Run with: ./mvnw spring-boot:run -Dspring.profiles.active=local
# Never commit application-local.properties (it is in .gitignore).

# --- AI (Groq) ---
# spring.ai.openai.api-key=gsk_your_key_here

# --- Database (Supabase connection pooling URI) ---
# spring.datasource.url=jdbc:postgresql://YOUR_PROJECT.pooler.supabase.com:6543/postgres?user=postgres.YOUR_REF&password=YOUR_PASSWORD
