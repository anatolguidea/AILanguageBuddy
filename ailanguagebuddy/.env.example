# Backend environment variables. Set these before running the Spring Boot app:
#   export $(cat .env | xargs)
#   ./mvnw spring-boot:run
# Or copy to .env and source it, or use application-local.properties (see application.properties.example).

# Groq API key (from https://console.groq.com)
GROQ_API_KEY=

# Supabase PostgreSQL connection URL (Connection pooling / transaction mode, port 6543)
# From Supabase: Project → Settings → Database → Connection string → URI (with pooler)
DATASOURCE_URL=
