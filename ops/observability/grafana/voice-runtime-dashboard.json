{
  "title": "Voice Runtime",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Voice Turns Started vs Completed",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voice_turn_started_total[$__rate_interval]))",
          "legendFormat": "started/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(voice_turn_completed_total[$__rate_interval]))",
          "legendFormat": "completed/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Voice Turn Failure Rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voice_turn_failed_total[$__rate_interval])) / clamp_min(sum(rate(voice_turn_started_total[$__rate_interval])), 0.001)",
          "legendFormat": "failure ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Voice Processing Latency (P95)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_turn_processing_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "WS Auth Failures",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voice_ws_connections_auth_failures_total[$__rate_interval]))",
          "legendFormat": "auth failures/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audio Input/Output Bytes (avg)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voice_turn_audio_input_bytes_sum[$__rate_interval])) / clamp_min(sum(rate(voice_turn_audio_input_bytes_count[$__rate_interval])), 0.001)",
          "legendFormat": "input avg bytes"
        },
        {
          "refId": "B",
          "expr": "sum(rate(voice_turn_audio_output_bytes_sum[$__rate_interval])) / clamp_min(sum(rate(voice_turn_audio_output_bytes_count[$__rate_interval])), 0.001)",
          "legendFormat": "output avg bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error Codes (rate)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(voice_ws_errors_total[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ]
    }
  ]
}
